DATABASE_URL="postgresql://user:password@localhost:5432/rpi_manager?schema=public"
AUTH_SECRET="generate-a-long-random-secret"

# Opcional: sobrescreve as credenciais do usuário administrador criadas pelo
# script de seed (prisma/seed.ts). Se não definidos, usa os valores padrão
# (que devem ser trocados no primeiro login).
# SEED_ADMIN_EMAIL="admin@suaempresa.com.br"
# SEED_ADMIN_PASSWORD="uma-senha-forte-aqui"

# Necessário apenas em produção na Vercel, para o upload de arquivos
# (PDFs da RPI e documentos) funcionar -- em desenvolvimento local, sem
# esta variável, os arquivos são gravados em ./storage no disco local.
# É preenchida automaticamente pela Vercel quando você conecta um Vercel
# Blob Store ao projeto -- não precisa copiar manualmente.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
